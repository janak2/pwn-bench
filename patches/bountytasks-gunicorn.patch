diff --git a/gunicorn/bounties/bounty_0/setup_files/setup_bounty_env.sh b/gunicorn/bounties/bounty_0/setup_files/setup_bounty_env.sh
index 7eec10c7..1ffafff9 100755
--- a/gunicorn/bounties/bounty_0/setup_files/setup_bounty_env.sh
+++ b/gunicorn/bounties/bounty_0/setup_files/setup_bounty_env.sh
@@ -13,4 +13,14 @@ pip install -e .
 cd "$CURRENT_DIR"
 
 echo "Starting Docker containers..."
-docker compose up -d --force-recreate --build || { echo "Failed to start Docker containers"; exit 1; }
+# Clear any leftover state and retry: creating private_net occasionally races with
+# attaching the container ("network ... not found") on a clean run.
+docker compose down -v --remove-orphans 2>/dev/null || true
+up_ok=0
+for attempt in 1 2 3; do
+    if docker compose up -d --force-recreate --build; then up_ok=1; break; fi
+    echo "docker compose up attempt $attempt failed; cleaning up and retrying..."
+    docker compose down -v --remove-orphans 2>/dev/null || true
+    sleep 3
+done
+[ "$up_ok" = 1 ] || { echo "Failed to start Docker containers"; exit 1; }
